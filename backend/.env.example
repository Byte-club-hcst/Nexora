# Server Environment
PORT=5000
NODE_ENV=development

# Allowed CORS Origins (comma-separated or single URL)
FRONTEND_URL=http://localhost:5173,https://nexora.tech,https://www.nexora.tech

# Set to true only if you want to connect to live external Firebase instead of in-memory mock engine
USE_LIVE_FIREBASE=true
FIREBASE_PROJECT_ID=nexora-2026-local
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Set to true only if you want to connect to live Cloudflare R2 instead of in-memory/local mock
USE_LIVE_R2=true
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=nexora-2026-local

# Email Service (Optional - logs to server console in local development)
EMAIL_API_KEY=

